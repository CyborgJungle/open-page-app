{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/capture", "destination": "/api/index?__page_path=api/capture" },
    { "source": "/api/health", "destination": "/api/index?__page_path=api/health" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] },
    { "source": "/", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'unsafe-inline'; worker-src 'self'; manifest-src 'self'; style-src 'unsafe-inline' https: http:; connect-src 'self'; img-src https: http: data:; font-src https: http: data:; media-src https: http:; frame-src 'self'; base-uri https: http:; frame-ancestors 'none'; form-action 'none'" }
    ] },
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache" },
      { "key": "Service-Worker-Allowed", "value": "/" }
    ] },
    { "source": "/manifest.webmanifest", "headers": [
      { "key": "Content-Type", "value": "application/manifest+json" },
      { "key": "Cache-Control", "value": "no-cache" }
    ] }
  ]
}
